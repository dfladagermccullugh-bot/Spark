# Spark Agent Configuration
# ========================

# ── LLM Provider ─────────────────────────────────────────────────────
# Spark works with any LLM provider. Set ONE API key for your provider.

# Anthropic (Claude)
# SPARK_ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o, o3, etc.)
# SPARK_OPENAI_API_KEY=sk-...

# Google (Gemini)
# SPARK_GEMINI_API_KEY=...

# Groq (fast open-source models)
# SPARK_GROQ_API_KEY=gsk_...

# OpenRouter (access any model via one API)
# SPARK_OPENROUTER_API_KEY=sk-or-...

# Generic fallback (works with any litellm-supported provider)
# SPARK_LLM_API_KEY=...

# Custom endpoint (for Ollama, vLLM, or self-hosted models)
# SPARK_LLM_API_BASE=http://localhost:11434

# Model to use (default: claude-sonnet-4-20250514)
# Examples:
#   claude-sonnet-4-20250514          (Anthropic)
#   gpt-4o                            (OpenAI)
#   gemini/gemini-2.5-flash           (Google)
#   groq/llama-3.3-70b-versatile      (Groq)
#   ollama/llama3.1                    (Ollama - local, free)
#   openrouter/anthropic/claude-sonnet-4 (OpenRouter)
# SPARK_MODEL=claude-sonnet-4-20250514

# ── Telegram ─────────────────────────────────────────────────────────
# Required for messaging delivery

# Bot token (get from @BotFather on Telegram)
SPARK_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Your chat ID (get from @userinfobot on Telegram)
SPARK_TELEGRAM_CHAT_ID=123456789

# ── Paths ────────────────────────────────────────────────────────────
# SPARK_PROJECTS_DIR=~/projects
# SPARK_KNOWLEDGE_DIR=~/knowledge
# SPARK_DATA_DIR=~/.spark

# ── Preferences ──────────────────────────────────────────────────────
# SPARK_TIMEZONE=America/New_York
# SPARK_QUIET_HOURS_START=22:00
# SPARK_QUIET_HOURS_END=08:00

# Agency level: suggest (default), light, or full
# SPARK_AGENCY_LEVEL=suggest

# SPARK_MAX_DAILY_NUDGES=3

# ── Intelligence (all default to true) ───────────────────────────────
# SPARK_DAILY_DIGEST_ENABLED=true
# SPARK_WEEKLY_DIGEST_ENABLED=true
# SPARK_ENRICH_KNOWLEDGE=true
# SPARK_LEARN_FROM_CONVERSATIONS=true
