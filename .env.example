# Spark Agent Configuration

# Required: Anthropic API key for Claude
# Get yours at https://console.anthropic.com/
SPARK_ANTHROPIC_API_KEY=sk-ant-...

# Required: Telegram bot token (get from @BotFather on Telegram)
SPARK_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Required: Your Telegram chat ID (get from @userinfobot on Telegram)
SPARK_TELEGRAM_CHAT_ID=123456789

# Optional: Override default paths
# SPARK_PROJECTS_DIR=~/projects
# SPARK_KNOWLEDGE_DIR=~/knowledge
# SPARK_DATA_DIR=~/.spark

# Optional: Timezone (default: UTC)
# SPARK_TIMEZONE=America/New_York

# Optional: Quiet hours - no nudges during these hours (default: 22:00-08:00)
# SPARK_QUIET_HOURS_START=22:00
# SPARK_QUIET_HOURS_END=08:00

# Optional: Agency level - how autonomous Spark can be
#   suggest = ideas only (default)
#   light   = can write code + research, push needs approval
#   full    = fully autonomous
# SPARK_AGENCY_LEVEL=suggest

# Optional: Max nudges per day (default: 3)
# SPARK_MAX_DAILY_NUDGES=3

# Optional: LLM model (default: claude-sonnet-4-20250514)
# SPARK_MODEL=claude-sonnet-4-20250514

# Optional: Intelligence features (all default to true)
# SPARK_DAILY_DIGEST_ENABLED=true
# SPARK_WEEKLY_DIGEST_ENABLED=true
# SPARK_ENRICH_KNOWLEDGE=true
# SPARK_LEARN_FROM_CONVERSATIONS=true
